# Expo Go on a physical phone cannot reach the development computer via localhost.
# Replace localhost with your computer's LAN IP (for example, 192.168.1.25).
EXPO_PUBLIC_API_URL=http://localhost:4000

# Local PostgreSQL. Set your own password in .env; never commit .env.
POSTGRES_DB=api_inspector
POSTGRES_USER=api_inspector
POSTGRES_PASSWORD=replace-with-a-local-password
PORT=4000
CORS_ORIGIN=*
